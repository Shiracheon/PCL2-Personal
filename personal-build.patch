@@ -0,0 +1,95 @@
+[CmdletBinding()]
+param(
+    [ValidateSet('Debug', 'Release')][string]$Configuration = 'Release',
+    [string]$MicrosoftClientId = $env:PCL_MS_CLIENT_ID,
+    [string]$CurseForgeApiKey = $env:PCL_CURSEFORGE_API_KEY,
+    [switch]$ForDistribution
+)
+
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+if ($env:OS -ne 'Windows_NT') { throw 'This WPF project must be built on Windows.' }
+$projectRoot = Split-Path -Parent $PSScriptRoot
+if ($ForDistribution) {
+    $parsedId = [Guid]::Empty
+    if (-not [Guid]::TryParse($MicrosoftClientId, [ref]$parsedId) -or $parsedId -eq [Guid]::Empty) {
+        throw 'A publisher-owned Microsoft application Client ID is required for distribution. End users do not need to register an app.'
+    }
+}
+if ([string]::IsNullOrWhiteSpace($MicrosoftClientId)) {
+    Write-Warning 'Microsoft login is not configured. This build is for testing only.'
+}
+if ([string]::IsNullOrWhiteSpace($CurseForgeApiKey)) {
+    Write-Warning 'CurseForge API access is not configured; Modrinth and Minecraft downloads remain independent.'
+}
+
+$msbuild = Get-Command MSBuild.exe -ErrorAction SilentlyContinue
+if ($msbuild) {
+    $msbuildPath = $msbuild.Source
+} else {
+    $vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
+    if (-not (Test-Path -LiteralPath $vswhere)) { throw 'Install Visual Studio 2022 Build Tools with the .NET desktop build tools and .NET Framework 4.8 targeting pack.' }
+    $msbuildPath = & $vswhere -latest -products '*' -requires Microsoft.Component.MSBuild -find 'MSBuild\**\Bin\MSBuild.exe' | Select-Object -First 1
+}
+if (-not $msbuildPath) { throw 'MSBuild.exe was not found.' }
+if (-not (Get-Command dotnet -ErrorAction SilentlyContinue)) { throw '.NET SDK 9 or newer is required for C# 13 dependencies.' }
+if (-not (Test-Path -LiteralPath (Join-Path $projectRoot 'MeloongCore\Shared\MeloongCore.csproj'))) {
+    throw 'MeloongCore source is missing. Use the complete source package with its pinned vendored dependency.'
+}
+
+Push-Location $projectRoot
+try {
+    & dotnet restore 'PCLCS\PCLCS.csproj'
+    if ($LASTEXITCODE -ne 0) { throw 'NuGet restore failed.' }
+    & $msbuildPath 'Plain Craft Launcher 2\Plain Craft Launcher 2.vbproj' /t:Rebuild "/p:Configuration=$Configuration" /p:Platform=AnyCPU /m /verbosity:minimal
+    if ($LASTEXITCODE -ne 0) { throw 'Windows build failed.' }
+
+    $binaryFolder = Join-Path $projectRoot 'Plain Craft Launcher 2\bin'
+    $exeName = 'Plain Craft Launcher 2.exe'
+    $exe = Join-Path $binaryFolder $exeName
+    if (-not (Test-Path -LiteralPath $exe)) { throw 'The expected executable was not produced.' }
+    $packageName = if ($ForDistribution) { 'PCL2-Personal-Windows' } else { 'PCL2-Personal-Windows-Test' }
+    $outputRoot = Join-Path $projectRoot 'artifacts'
+    New-Item -ItemType Directory -Force -Path $outputRoot | Out-Null
+    $staging = Join-Path ([IO.Path]::GetTempPath()) ('pcl-personal-package-' + [Guid]::NewGuid().ToString('N'))
+    $package = Join-Path $staging $packageName
+    New-Item -ItemType Directory -Force -Path $package | Out-Null
+    try {
+        # Ship the complete compiled runtime set, never a user's PCL settings or account cache.
+        Get-ChildItem -LiteralPath $binaryFolder -File | Where-Object { $_.Extension -in '.exe', '.dll', '.config' } | Copy-Item -Destination $package
+        Get-ChildItem -LiteralPath $binaryFolder -Directory | Where-Object { $_.Name -match '^[a-z]{2}(-[A-Za-z]+)?$' } | Copy-Item -Destination $package -Recurse
+        $configPath = Join-Path $package ($exeName + '.config')
+        $config = New-Object System.Xml.XmlDocument
+        $config.PreserveWhitespace = $true
+        $config.Load((Join-Path $projectRoot 'Plain Craft Launcher 2\App.config'))
+        $config.SelectSingleNode('/configuration/appSettings/add[@key="PersonalMicrosoftClientId"]').SetAttribute('value', [string]$MicrosoftClientId)
+        $config.SelectSingleNode('/configuration/appSettings/add[@key="PersonalCurseForgeApiKey"]').SetAttribute('value', [string]$CurseForgeApiKey)
+        $xmlSettings = New-Object System.Xml.XmlWriterSettings
+        $xmlSettings.Encoding = New-Object System.Text.UTF8Encoding($false)
+        $xmlSettings.Indent = $true
+        $writer = [System.Xml.XmlWriter]::Create($configPath, $xmlSettings)
+        try { $config.Save($writer) } finally { $writer.Dispose() }
+        Copy-Item -LiteralPath 'LICENCE', 'PERSONAL-README.md', 'SOURCE-NOTICE.txt' -Destination $package
+        Copy-Item -LiteralPath 'MeloongCore\LICENSE.txt' -Destination (Join-Path $package 'MeloongCore-LICENSE.txt')
+        # Include matching source. Exclude outputs, repository metadata and local credentials.
+        Add-Type -AssemblyName System.IO.Compression.FileSystem
+        $sourceZipPath = Join-Path $package 'Personal-Source.zip'
+        $sourceZip = [IO.Compression.ZipFile]::Open($sourceZipPath, [IO.Compression.ZipArchiveMode]::Create)
+        try {
+            Get-ChildItem -LiteralPath $projectRoot -Recurse -File -Force | ForEach-Object {
+                $relative = $_.FullName.Substring($projectRoot.Length + 1).Replace('\', '/')
+                if ($relative -match '(^|/)(\.git|\.vs|bin|obj|artifacts|__pycache__|patches)(/|$)' -or
+                    $relative -match '(^|/)(\.env.*|.*\.user|.*\.pfx|最新正式版\.zip)$') { return }
+                [IO.Compression.ZipFileExtensions]::CreateEntryFromFile($sourceZip, $_.FullName, $relative, [IO.Compression.CompressionLevel]::Optimal) | Out-Null
+            }
+        } finally { $sourceZip.Dispose() }
+        $zipPath = Join-Path $outputRoot ($packageName + '.zip')
+        if (Test-Path -LiteralPath $zipPath) { Remove-Item -LiteralPath $zipPath }
+        Compress-Archive -LiteralPath $package -DestinationPath $zipPath -CompressionLevel Optimal
+        $hash = Get-FileHash -LiteralPath $zipPath -Algorithm SHA256
+        [IO.File]::WriteAllText($zipPath + '.sha256', $hash.Hash.ToLowerInvariant() + '  ' + [IO.Path]::GetFileName($zipPath) + "`n", (New-Object System.Text.UTF8Encoding($false)))
+        Write-Host "Package: $zipPath"
+    } finally {
+        if (Test-Path -LiteralPath $staging) { Remove-Item -LiteralPath $staging -Recurse -Force }
+    }
+} finally { Pop-Location }
diff --git a/modified/tests/Verify-PersonalPolicy.ps1 b/modified/tests/Verify-PersonalPolicy.ps1
new file mode 100644
index 0000000..e5e8747
--- /dev/null
+++ b/modified/tests/Verify-PersonalPolicy.ps1
@@ -0,0 +1,50 @@
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+# Compile the actual policy method in isolation against .NET Framework, then exercise it.
+# This does not require a WPF window, user account, or network access.
+$sourcePath = Join-Path (Split-Path -Parent $PSScriptRoot) 'Plain Craft Launcher 2\Modules\ModSecret.vb'
+$source = [IO.File]::ReadAllText($sourcePath, [Text.Encoding]::UTF8)
+$match = [regex]::Match($source, '(?ms)^    Friend Sub CheckPersonalServiceUrl\(Url As String\)\r?\n.*?^    End Sub')
+if (-not $match.Success) { throw 'Service policy method was not found.' }
+$method = $match.Value.Replace('Friend Sub ', 'Public Shared Sub ')
+$testSource = "Imports System`nImports System.Linq`nPublic Class PersonalPolicyTest`n$method`nEnd Class"
+$provider = New-Object Microsoft.VisualBasic.VBCodeProvider
+$parameters = New-Object System.CodeDom.Compiler.CompilerParameters
+$parameters.GenerateInMemory = $true
+$parameters.ReferencedAssemblies.Add('System.dll') | Out-Null
+$parameters.ReferencedAssemblies.Add('System.Core.dll') | Out-Null
+try {
+    $compiled = $provider.CompileAssemblyFromSource($parameters, $testSource)
+    if ($compiled.Errors.HasErrors) { throw (($compiled.Errors | ForEach-Object { $_.ToString() }) -join "`n") }
+    $type = $compiled.CompiledAssembly.GetType('PersonalPolicyTest')
+    $policy = $type.GetMethod('CheckPersonalServiceUrl')
+    $blocked = @(
+        'https://meloong.com/pcl', 'https://MCNEWS.MELOONG.COM/',
+        'https://a.meloong.com:443/notice', 'http://413.open.pcl2.server/',
+        'https://pcl2-server.top/update', 'https://x.pcl2-server.top/'
+    )
+    $allowed = @(
+        'https://launchermeta.mojang.com/mc/game/version_manifest.json',
+        'https://piston-data.mojang.com/v1/objects/example/client.jar',
+        'https://bmclapi2.bangbang93.com/mc/game/version_manifest.json',
+        'https://login.microsoftonline.com/consumers/oauth2/v2.0/devicecode',
+        'https://user.auth.xboxlive.com/user/authenticate',
+        'https://api.minecraftservices.com/minecraft/profile',
+        'https://api.modrinth.com/v2/search', 'https://api.curseforge.com/v1/mods',
+        'https://meta.fabricmc.net/v2/versions', 'https://maven.neoforged.net/releases/',
+        'https://meloong.com.example.org/', 'https://example.org/meloong.com',
+        'https://meloong.com@example.org/'
+    )
+    foreach ($url in $blocked) {
+        $denied = $false
+        try { $policy.Invoke($null, @($url)) | Out-Null } catch {
+            $exception = $_.Exception
+            while ($exception.InnerException) { $exception = $exception.InnerException }
+            if ($exception -isnot [InvalidOperationException]) { throw }
+            $denied = $true
+        }
+        if (-not $denied) { throw "Upstream service unexpectedly allowed: $url" }
+    }
+    foreach ($url in $allowed) { $policy.Invoke($null, @($url)) | Out-Null }
+    Write-Host "Policy behavior passed: $($blocked.Count) denied, $($allowed.Count) allowed."
+} finally { $provider.Dispose() }
diff --git a/modified/tests/smoke_download_sources.py b/modified/tests/smoke_download_sources.py
