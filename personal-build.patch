index 0000000..9bf1780
--- /dev/null
+++ b/modified/tests/smoke_download_sources.py
@@ -0,0 +1,38 @@
+"""Optional live smoke check of public version sources; not a Windows install test."""
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+from urllib.request import Request, urlopen
+
+SOURCES = {
+    'Mojang': 'https://launchermeta.mojang.com/mc/game/version_manifest.json',
+    'BMCLAPI': 'https://bmclapi2.bangbang93.com/mc/game/version_manifest.json',
+}
+
+def get(url):
+    with urlopen(Request(url, headers={'User-Agent': 'PCL2-Personal-SourceCheck/1.0'}), timeout=25) as response:
+        return response.read()
+
+def check_source(item):
+    name, url = item
+    manifest = json.loads(get(url))
+    assert manifest['versions'], f'{name}: empty version list'
+    print(f'{name}: {len(manifest["versions"])} versions; latest release {manifest["latest"]["release"]}', flush=True)
+    return name, manifest
+
+if __name__ == '__main__':
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = dict(pool.map(check_source, SOURCES.items()))
+    # Validate a known release manifest and a small library by the official SHA-1.
+    entry = next(v for v in results['Mojang']['versions'] if v['id'] == '1.21.1')
+    raw = get(entry['url'])
+    if entry.get('sha1'):
+        assert hashlib.sha1(raw).hexdigest() == entry['sha1']
+    version = json.loads(raw)
+    assert version['downloads']['client']['url'].startswith('https://')
+    candidates = [v['downloads']['artifact'] for v in version['libraries'] if v.get('downloads', {}).get('artifact')]
+    artifact = min((v for v in candidates if v['size'] >= 1024), key=lambda v: v['size'])
+    data = get(artifact['url'])
+    assert len(data) == artifact['size']
+    assert hashlib.sha1(data).hexdigest() == artifact['sha1']
+    print(f'Official 1.21.1 metadata parsed; sample library verified ({len(data)} bytes, SHA-1 matched).')
diff --git a/modified/tests/verify_source.py b/modified/tests/verify_source.py
new file mode 100644
index 0000000..f367cc5
--- /dev/null
+++ b/modified/tests/verify_source.py
@@ -0,0 +1,125 @@
+"""Check fork integration invariants; this does not compile or run the Windows UI."""
+from pathlib import Path
+import re
+import unittest
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+APP = ROOT / 'Plain Craft Launcher 2'
+NS = {'m': 'http://schemas.microsoft.com/developer/msbuild/2003'}
+
+def read(path):
+    return (APP / path).read_text(encoding='utf-8-sig')
+
+def method(path, signature, end='Sub'):
+    match = re.search(r'(?ms)^    ' + re.escape(signature) + r'\r?\n(.*?)^    End ' + end, read(path))
+    if not match:
+        raise AssertionError(f'Missing method: {signature}')
+    return match.group(1)
+
+class PersonalSourceChecks(unittest.TestCase):
+    def test_download_routes_are_reenabled(self):
+        self.assertRegex(read('Modules/ModSecret.vb'), r'RestrictMcDownload As Boolean = False')
+        for path in ('Pages/PageDownload/PageDownloadInstall.xaml.vb',
+                     'Pages/PageDownload/PageDownloadModify.vb',
+                     'Pages/PageDownload/Resource/PageDownloadCompDetail.xaml.vb',
+                     'Modules/Minecraft/ModModpack.vb'):
+            self.assertIn('RestrictMcDownload', read(path))
+        source = read('Modules/Minecraft/ModDownload.vb')
+        self.assertIn('https://launchermeta.mojang.com/mc/game/version_manifest.json', source)
+        self.assertIn('https://bmclapi2.bangbang93.com/mc/game/version_manifest.json', source)
+
+    def test_no_updater_or_telemetry_execution(self):
+        startup = read('Application.xaml.vb')
+        self.assertLess(startup.index('If e.Args.Contains("--update")'), startup.index('MeloongCore.Main.Init'))
+        self.assertNotIn('UpdateReplace(e.Args', startup)
+        self.assertNotIn('ServerLoader.Start()', read('FormMain.xaml.vb'))
+        self.assertNotIn('清理自动更新文件', read('FormMain.xaml.vb'))
+        body = method('Modules/ModMain.vb', 'Public Sub Telemetry([Event] As String, ParamArray Datas As String())')
+        self.assertNotIn('NetRequest', body)
+        for signature in ('Public Sub UpdateRestart(TriggerRestartAndByEnd As Boolean)',
+                          'Public Sub UpdateReplace(ProcessId As Integer, OldFileName As String, NewFileName As String, TriggerRestart As Boolean)'):
+            self.assertFalse(method('Modules/ModSecret.vb', signature).strip())
+
+    def test_official_home_and_feedback_removed(self):
+        feedback = method('Modules/ModMain.vb', 'Public Sub Feedback(Optional ShowMsgbox As Boolean = True, Optional ForceOpenLog As Boolean = False)')
+        self.assertNotIn('OpenWebsite', feedback)
+        left = read('Pages/PageOther/PageOtherLeft.xaml.vb')
+        self.assertNotIn('https://github.com/Meloong-Git/PCL', left)
+        source = read('Pages/PageLaunch/PageLaunchRight.xaml.vb')
+        self.assertNotIn('https://mcnews.meloong.com', source)
+        self.assertIn('CheckPersonalServiceUrl(Url)', source)
+
+    def test_network_policy_covers_both_engines(self):
+        secret = read('Modules/ModSecret.vb')
+        self.assertIn('CheckPersonalServiceUrl(UrlWithMark.Replace', secret)
+        self.assertNotIn('Req.Headers.Add("Referer"', secret)
+        net = read('Modules/Base/ModNet.vb')
+        self.assertIn('Url = SecretCdnSign(Url)', net)
+        self.assertIn('.Url = SecretCdnSign(Source.', net)
+
+    def test_login_is_publisher_configured(self):
+        config = ET.parse(APP / 'App.config')
+        values = {e.attrib['key']: e.attrib['value'] for e in config.findall('./appSettings/add')}
+        self.assertEqual(values['PersonalMicrosoftClientId'], '')
+        self.assertEqual(values['PersonalCurseForgeApiKey'], '')
+        self.assertIn('System.Configuration.ConfigurationManager.AppSettings', read('Modules/ModSecret.vb'))
+        auth = read('Modules/Minecraft/ModLaunch.vb')
+        for endpoint in ('https://login.microsoftonline.com/consumers/oauth2/v2.0/devicecode',
+                         'https://api.minecraftservices.com/authentication/login_with_xbox',
+                         'https://api.minecraftservices.com/entitlements/mcstore'):
+            self.assertIn(endpoint, auth)
+        self.assertIn('无需使用者自行申请', auth)
+        self.assertNotIn('client_secret=', auth)
+
+    def test_export_carries_current_build(self):
+        export = read('Pages/PageInstance/PageInstanceExport.xaml.vb')
+        self.assertNotIn('DownloadLatestPCL(', export)
+        self.assertNotIn('Latest.exe', export)
+        self.assertIn('FileUtils.Copy(PathExe, CacheFolder & "Plain Craft Launcher.exe")', export)
+        self.assertIn('Plain Craft Launcher.exe.config', export)
+        self.assertIn('Personal-Source.zip', export)
+
+    def test_xml_and_project_inputs(self):
+        paths = list(APP.rglob('*.xaml')) + list(ROOT.rglob('*.csproj')) + list(ROOT.rglob('*.vbproj')) + [APP / 'App.config']
+        for path in paths:
+            if path == APP / 'Resources/Custom.xaml':
+                # The bundled homepage is an XML fragment, wrapped by PageLaunchRight at runtime.
+                ET.fromstring('<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" '
+                              'xmlns:local="clr-namespace:PCL" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" '
+                              'xmlns:sys="clr-namespace:System;assembly=mscorlib" '
+                              'xmlns:core="clr-namespace:MeloongCore" xmlns:corewpf="clr-namespace:MeloongCore.Wpf">'
+                              + path.read_text(encoding='utf-8-sig') + '</StackPanel>')
+            else:
+                ET.parse(path)
+        project = ET.parse(APP / 'Plain Craft Launcher 2.vbproj')
+        for tag in ('Compile', 'Page', 'Resource', 'ApplicationDefinition', 'ProjectReference'):
+            for entry in project.findall(f'.//m:{tag}', NS):
+                path = APP / entry.attrib['Include'].replace('\\', '/')
+                self.assertTrue(path.is_file(), f'Missing {tag}: {path}')
+
+    def test_disabled_ui_controls_and_credits(self):
+        tree = ET.parse(APP / 'Pages/PageSetup/PageSetupSystem.xaml')
+        xname = '{http://schemas.microsoft.com/winfx/2006/xaml}Name'
+        controls = {e.attrib.get(xname): e for e in tree.iter() if xname in e.attrib}
+        for name in ('ComboSystemUpdate', 'ComboSystemActivity', 'CheckSystemTelemetry', 'BtnSystemUpdate'):
+            self.assertEqual(controls[name].attrib['IsEnabled'], 'False')
+        about = read('Pages/PageOther/PageOtherAbout.xaml')
+        self.assertIn('个人修改版', about)
+        self.assertIn('Title="龙腾猫跃"', about)
+        self.assertIn('https://meloong.com/afd/a/LTCat', about)
+        self.assertTrue((ROOT / 'LICENCE').is_file())
+        self.assertTrue((ROOT / 'MeloongCore/LICENSE.txt').is_file())
+
+    def test_distribution_build_has_no_upstream_checkout(self):
+        workflow = (ROOT / '.github/workflows/build.yml').read_text()
+        self.assertIn('workflow_dispatch:', workflow)
+        self.assertNotIn('git clone', workflow)
+        self.assertNotIn('secrets.CLIENT_ID', workflow)
+        script = (ROOT / 'build/Build-Windows.ps1').read_text()
+        self.assertIn('if ($ForDistribution)', script)
+        self.assertIn('Personal-Source.zip', script)
+        self.assertNotIn('git clone', script)
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
